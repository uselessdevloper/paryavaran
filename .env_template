# ── Paryavaran / Bhubaneswar India environment template ──────────────────────
# Copy this file to .env and fill in real values.
# The Ordnance Survey keys have been removed; all land-type data now comes
# from ESA WorldCover, OpenStreetMap (no key needed), and the CPCB open portal.

# ── Optional: OpenWeather / CPCB (if you need live AQI lookups) ──────────────
# OPENWEATHER_API_KEY=
# DATA_GOV_IN_API_KEY=      # https://data.gov.in – required only for live pull

# ── Optional: NASA EarthData (for programmatic MODIS LST download) ────────────
# NASA_EARTHDATA_USERNAME=
# NASA_EARTHDATA_PASSWORD=

# ── Optional: AWS S3 (only if you use S3 for storage) ────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
# S3_BUCKET=